# Auto detect text files and perform LF normalization
* text=auto

# Ensure gradlew script has LF endings for Linux/macOS compatibility
gradlew text eol=lf
gradlew.bat text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
*.so binary
