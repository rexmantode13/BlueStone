<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Header with Bluetooth and Location badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tile_attended"
            android:padding="9dp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/primary"
            android:contentDescription="Verification Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.BlueStone.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="Classroom Verification" />

            <TextView
                android:id="@+id/tv_verify_lecture_info"
                style="@style/TextAppearance.BlueStone.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:text="CS202 • Lab 201" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/outline" />

    <!-- Details card -->
    <TextView
        style="@style/TextAppearance.BlueStone.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface"
        android:text="Turn on Location and Bluetooth to verify your physical presence via campus classroom BLE beacons and geofencing." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tile_total"
        android:padding="12dp">

        <TextView
            style="@style/TextAppearance.BlueStone.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_dark"
            android:textStyle="bold"
            android:text="📍 Classroom Location (GPS Active)" />

        <TextView
            style="@style/TextAppearance.BlueStone.LabelMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/primary_dark"
            android:textStyle="bold"
            android:text="📶 Bluetooth Beacon Scan (Faculty Room BLE)" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.BlueStone.LabelMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/on_surface_variant"
        android:text="Granting permission marks you Present. Denying or cancelling marks you Absent." />

</LinearLayout>
