<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal">

            <!-- Top Header Row with Greeting & Profile Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_greeting"
                        style="@style/TextAppearance.BlueStone.HeadlineMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:text="Hi, Rohan 👋" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="3dp">

                        <TextView
                            android:id="@+id/tv_academic_semester_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_unmarked"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:text="Sem 2" />

                        <TextView
                            android:id="@+id/tv_academic_info"
                            style="@style/TextAppearance.BlueStone.BodyMedium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp"
                            android:letterSpacing="0.01"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="B.Tech CSE" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_profile_header"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_tile_total"
                    android:padding="9dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/primary"
                    android:contentDescription="Profile Avatar" />
            </LinearLayout>

            <!-- Minimal Indigo Hero Attendance Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_overall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="MY ATTENDANCE GOAL"
                            android:textColor="#E0D4FF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.10" />

                        <TextView
                            android:id="@+id/tv_overall_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_glass"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:text="Good Standing" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:id="@+id/tv_overall_percentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="54sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:text="72.1%" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/tv_overall_fraction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#EFE8FF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="49 / 68 classes attended" />

                            <TextView
                                android:id="@+id/tv_overall_target_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#D1C2F7"
                                android:textSize="12sp"
                                android:text="Target: 75.0% minimum required" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Student Goal Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progress_overall_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        android:progress="72"
                        android:progressDrawable="@drawable/bg_hero_progress" />

                    <!-- Student Target Advice Pill -->
                    <TextView
                        android:id="@+id/tv_overall_advice_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_badge_glass"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="⚡ Attend 2 more classes to reach 75% target" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Action Button: Mark Attendance -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_mark"
                style="@style/Widget.BlueStone.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="@string/mark_attendance"
                app:icon="@drawable/ic_attendance"
                app:cornerRadius="14dp" />

            <!-- 4 Metric Tiles Grid -->
            <TextView
                style="@style/TextAppearance.BlueStone.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Attendance Review" />

            <!-- Grid Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Attended Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tile_attended"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_stat_attended"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="49"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:textColor="@color/primary_dark" />

                    <TextView
                        style="@style/TextAppearance.BlueStone.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:text="Attended Classes" />
                </LinearLayout>

                <!-- Missed Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tile_missed"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_stat_missed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:textColor="@color/primary_dark" />

                    <TextView
                        style="@style/TextAppearance.BlueStone.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface_variant"
                        android:text="Missed Classes" />
                </LinearLayout>

            </LinearLayout>

            <!-- Grid Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- Total Classes Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tile_total"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_stat_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="68"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:textColor="@color/primary_dark" />

                    <TextView
                        style="@style/TextAppearance.BlueStone.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:text="Total Sessions" />
                </LinearLayout>

                <!-- Required Target Tile -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tile_target"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_stat_target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="75%"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:textColor="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.BlueStone.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        android:text="Goal" />
                </LinearLayout>

            </LinearLayout>

            <!-- Horizontal Day Pills -->
            <TextView
                style="@style/TextAppearance.BlueStone.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="Weekly Overview" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="12dp"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Day Pill 1: Mon -->
                    <LinearLayout
                        android:id="@+id/ll_day_pill_1"
                        android:layout_width="62dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_date_pill_active"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:id="@+id/tv_day_pill_1_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="19"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_day_pill_1_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Mon"
                            android:textColor="#D8CCFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Day Pill 2: Tue -->
                    <LinearLayout
                        android:id="@+id/ll_day_pill_2"
                        android:layout_width="62dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_date_pill_inactive"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:id="@+id/tv_day_pill_2_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_day_pill_2_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tue"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Day Pill 3: Wed -->
                    <LinearLayout
                        android:id="@+id/ll_day_pill_3"
                        android:layout_width="62dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_date_pill_inactive"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:id="@+id/tv_day_pill_3_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="21"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_day_pill_3_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Wed"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Day Pill 4: Thu -->
                    <LinearLayout
                        android:id="@+id/ll_day_pill_4"
                        android:layout_width="62dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_date_pill_inactive"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <TextView
                            android:id="@+id/tv_day_pill_4_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="22"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_day_pill_4_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Thu"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Day Pill 5: Fri -->
                    <LinearLayout
                        android:id="@+id/ll_day_pill_5"
                        android:layout_width="62dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_date_pill_inactive"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_day_pill_5_num"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23"
                            android:textColor="@color/on_surface"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tv_day_pill_5_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Fri"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Today's Schedule Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp">

                <TextView
                    style="@style/TextAppearance.BlueStone.TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="@string/today_classes" />

                <TextView
                    android:id="@+id/tv_quick_mark_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mark Attendance →"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_today_classes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- Empty Today Classes View -->
            <TextView
                android:id="@+id/tv_empty_today"
                style="@style/TextAppearance.BlueStone.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/no_classes_today"
                android:gravity="center"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Subjects Overview Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="28dp">

                <TextView
                    style="@style/TextAppearance.BlueStone.TitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="@string/nav_subjects" />

                <TextView
                    android:id="@+id/tv_view_all_subjects"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All →"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dashboard_subjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
